APP_NAME="Search Trends Service"
LOG_LEVEL=INFO
REDIS_URL=redis://redis:6379/0
KAFKA_BOOTSTRAP_SERVERS=kafka:9092
KAFKA_TOPIC=search.events.v1
KAFKA_CONSUMER_GROUP=search-trends-v1
WORKER_METRICS_PORT=9000
WINDOW_SECONDS=300
BUCKET_SECONDS=10
TOP_CACHE_SECONDS=1
MAX_TOP_LIMIT=100
MAX_EVENTS_PER_ACTOR_QUERY=30
RATE_WINDOW_SECONDS=10
ADMIN_TOKEN=replace-with-a-long-random-token
